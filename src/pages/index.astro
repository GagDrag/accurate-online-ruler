---
import Layout from "../layouts/Layout.astro";
import RulerApp from "../components/RulerApp";
---

<Layout>
	<main class="relative w-full min-h-screen bg-canvas dark:bg-ink">
		{/* Ruler App Section */}
		<section class="sticky top-0 w-full h-screen z-10">
			<RulerApp client:only="react" />
		</section>

		{/* SEO Content Section */}
		<section id="about" class="relative z-20 bg-canvas dark:bg-ink border-t border-hairline dark:border-white/10 px-6 py-16 md:py-24 max-w-5xl mx-auto shadow-[0_-20px_50px_rgba(0,0,0,0.05)] rounded-t-[40px]">
			<div class="text-ink dark:text-white max-w-none">
				<div class="mb-16">
					<h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-8 dark:text-white text-center">The Ultimate Online Ruler</h2>
					<p class="text-xl leading-relaxed text-body dark:text-white/80 text-center max-w-3xl mx-auto">
						Your accurate tool for measuring anything, right in your browser. Physical precision meets digital convenience.
					</p>
				</div>
				
				<div class="grid md:grid-cols-2 gap-12 mb-20">
					<div class="space-y-4">
						<div class="w-12 h-12 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-500 mb-6">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
						</div>
						<h3 class="text-2xl font-semibold dark:text-white">Why Use an Online Ruler?</h3>
						<p class="leading-relaxed text-body dark:text-white/80">In today's digital age, having an <strong>online ruler</strong> at your fingertips is essential for designers, engineers, and students alike. Whether you need to measure a physical object against your screen or check dimensions of digital assets, our <strong>free online ruler</strong> provides professional accuracy without the need for physical tools.</p>
					</div>

					<div class="space-y-4">
						<div class="w-12 h-12 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-500 mb-6">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
						</div>
						<h3 class="text-2xl font-semibold dark:text-white">Actual Size Accuracy</h3>
						<p class="leading-relaxed text-body dark:text-white/80">Accuracy is the biggest challenge for virtual tools. Most fail because they don't account for your display's PPI. Our <strong>accurate online ruler</strong> solves this with multiple calibration methods, ensuring that 1 inch on your screen equals exactly 1 inch in the real world.</p>
					</div>

					<div class="space-y-4">
						<div class="w-12 h-12 rounded-2xl bg-green-500/10 flex items-center justify-center text-green-500 mb-6">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
						</div>
						<h3 class="text-2xl font-semibold dark:text-white">Metric & Imperial Units</h3>
						<p class="leading-relaxed text-body dark:text-white/80">Toggle between <strong>online ruler inches</strong> and <strong>online ruler cm</strong> instantly. Whether you need an <strong>mm online ruler</strong> for high-precision engineering or a standard <strong>12 inch online ruler</strong> for school projects, we have you covered.</p>
					</div>

					<div class="space-y-4">
						<div class="w-12 h-12 rounded-2xl bg-orange-500/10 flex items-center justify-center text-orange-500 mb-6">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
						</div>
						<h3 class="text-2xl font-semibold dark:text-white">Every Device, Every Screen</h3>
						<p class="leading-relaxed text-body dark:text-white/80">Our <strong>online ruler tool</strong> works seamlessly across all platforms. From 15-inch laptops to 27-inch monitors and smartphones, you can get an <strong>accurate online ruler</strong> in seconds using our physical reference calibration.</p>
					</div>
				</div>

				<div class="bg-canvas-soft dark:bg-white/5 border border-hairline dark:border-white/10 rounded-[32px] p-8 md:p-12 mb-20">
					<h3 class="text-2xl font-semibold mb-6 dark:text-white">Summary of Key Features</h3>
					<div class="grid sm:grid-cols-2 gap-4">
						{[
							"Online Ruler Inches Actual Size: Calibrated physical precision.",
							"Online Ruler in CM and MM: Perfect for engineering and design.",
							"12 Inch Online Ruler: Standard length for daily measuring.",
							"Real Online Ruler: Avoid errors of uncalibrated tools.",
							"Online Ruler to Scale: Works on smartphones, tablets, and monitors.",
							"Free Online Ruler: Professional-grade tools at no cost."
						].map((feature) => (
							<div class="flex items-start gap-3">
								<svg class="mt-1 flex-shrink-0 text-green-500" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span class="text-body dark:text-white/80">{feature}</span>
							</div>
						))}
					</div>
				</div>

				<h2 class="text-3xl md:text-4xl font-bold tracking-tight mt-16 mb-12 dark:text-white text-center">Frequently Asked Questions</h2>
				
				<div class="grid md:grid-cols-2 gap-6">
					{[
						{
							q: "Can I use my phone as a ruler?",
							a: "Yes! By calibrating the screen with a standard object like a credit card, your smartphone becomes a highly accurate online ruler capable of measuring small objects in actual size."
						},
						{
							q: "Is there a ruler online?",
							a: "Yes, our tool is a real online ruler that provides actual size measurements in both inches and cm after a quick calibration process."
						},
						{
							q: "How to identify 1 inch?",
							a: "On an accurate online ruler, 1 inch is identified by the major numbered markings. If calibrated correctly, the physical distance will be exactly 25.4mm."
						},
						{
							q: "How to measure cm online?",
							a: "Simply switch our tool to 'cm' mode. Once calibrated, the online ruler in cm will show precise metric divisions, where each mark represents one millimeter."
						},
						{
							q: "Can a smart phone measure?",
							a: "A smartphone can measure physical objects using an online ruler tool. Their high-density displays make for excellent actual size digital rulers."
						},
						{
							q: "Can I use my camera as a ruler?",
							a: "While AR camera apps exist, a calibrated screen ruler is generally more reliable for getting 100% accurate actual size results without special hardware."
						},
						{
							q: "Can we measure online?",
							a: "Absolutely. You can measure both digital elements and physical items using a browser-based online ruler inches actual size tool."
						},
						{
							q: "How to read a ruler online?",
							a: "Look for the long lines with numbers for whole units. The medium lines represent half-units, and the smallest lines represent mm or 1/16\" fractions."
						}
					].map((faq) => (
						<div class="p-6 rounded-2xl bg-canvas dark:bg-white/5 border border-hairline dark:border-white/10 hover:border-hairline-strong dark:hover:border-white/20 transition-all duration-300 shadow-sm group">
							<h3 class="text-lg font-semibold mb-3 text-ink dark:text-white group-hover:text-blue-500 transition-colors">{faq.q}</h3>
							<p class="text-body dark:text-white/80 leading-relaxed text-sm">{faq.a}</p>
						</div>
					))}
				</div>

				<div class="mt-20 text-center">
					<p class="text-body dark:text-white/60 text-sm">
						Built for precision. Always free. © {new Date().getFullYear()} realonlineruler.com
					</p>
				</div>
				<script type="application/ld+json">
				{
					"@context": "https://schema.org",
					"@type": "FAQPage",
					"mainEntity": [{
						"@type": "Question",
						"name": "Can I use my phone as a ruler?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Yes! You can use your phone as a ruler by visiting a calibrated online ruler website. By using a standard object like a credit card for calibration, your smartphone becomes an accurate measuring tool."
						}
					}, {
						"@type": "Question",
						"name": "Is there a ruler online?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Yes, our free online ruler provides actual size measurements in inches and cm on any device with a web browser."
						}
					}, {
						"@type": "Question",
						"name": "How to identify 1 inch?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "On a calibrated online ruler, 1 inch is the distance between the '0' and '1' major markings, representing exactly 25.4mm in physical space."
						}
					}, {
						"@type": "Question",
						"name": "How to measure cm online?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Switch the online ruler tool to 'cm' mode. Once your screen is calibrated, the tool will display precise centimeter and millimeter markings for metric measurement."
						}
					}, {
						"@type": "Question",
						"name": "Can a smart phone measure?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Yes, smartphones can measure physical objects using an online ruler. Their high-resolution screens make them ideal for actual size digital measurements."
						}
					}, {
						"@type": "Question",
						"name": "Can I use my camera as a ruler?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "While camera-based AR apps exist, a calibrated screen ruler is often more reliable for getting 100% accurate actual size results."
						}
					}, {
						"@type": "Question",
						"name": "Can we measure online?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Yes, you can measure both physical objects and digital screen elements using a calibrated online ruler tool."
						}
					}, {
						"@type": "Question",
						"name": "How to read a ruler online?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Identify major units (numbered), then halves, quarters, and finally the smallest increments (mm or 1/16 inches) for precise readings."
						}
					}, {
						"@type": "Question",
						"name": "How to use an online ruler?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Calibrate your screen using a standard reference (like a credit card), select your units, and then place your object against the screen markings."
						}
					}, {
						"@type": "Question",
						"name": "How to show ruler in PowerPoint Online or Word Online?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "In Word or PowerPoint Online, go to the 'View' tab and check the 'Ruler' option to display the built-in document rulers."
						}
					}]
				}
				</script>
			</div>
		</section>
	</main>
</Layout>

